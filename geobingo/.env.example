# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# Google Maps JavaScript API key (Maps JavaScript API + Street View must be
# enabled, and billing must be active in the Google Cloud Console).
#
# This key is sent to the browser — that is normal for a Maps JS key, but it
# MUST be locked down or anyone can rack up your bill:
#   - Restrict it by HTTP referrer to your own domain(s).
#   - Restrict it to only the "Maps JavaScript API" and "Geocoding API".
MAPS_API_KEY=your_google_maps_api_key_here

# Port the server listens on (default: 10200).
PORT=10200

# Optional: keep rooms in Cloudflare D1 via the data-proxy Worker
# (side-projects/data-proxy) instead of ./geobingo.db, so the container is
# stateless on disk and can restart on any host. Leave unset for local SQLite.
# GEOBINGO_D1_URL=https://data-proxy.<subdomain>.workers.dev/v1/geobingo
# GEOBINGO_D1_TOKEN=
